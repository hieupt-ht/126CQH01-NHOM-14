# Copy to .env and replace the password with a local random value.
# Use letters and numbers so the value is safe inside the MongoDB URI.
MONGO_INITDB_ROOT_USERNAME=flux_dev
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_random_local_password
MONGO_DATABASE=flux_studio
MONGODB_HOST_PORT=27017

MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGOOSE_AUTO_INDEX=true
FRONTEND_ORIGIN=http://localhost:5173
# Required by backend auth. Generate a private value of at least 32 bytes per environment.
JWT_SECRET=

# Keep false until MongoDB replica set, Cloudflare, and Cloudinary are configured.
GENERATION_ENABLED=false
# Docker Compose enables Vietnamese-to-English prompt translation locally.
# Each translated generation adds a Workers AI call.

# Cloudflare Workers AI / FLUX.1 Schnell credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudinary authenticated image storage credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ACCOUNT_ALIAS=demo-primary
CLOUDINARY_TIMEOUT_MS=30000
MAX_IMAGE_UPLOAD_MB=10
IMAGE_STORAGE_NAMESPACE=flux-studio/docker
DAILY_USER_LIMIT=20
DAILY_APP_LIMIT=20
