# Copy to .env and replace the password with a local random value.
# Use letters and numbers so the value is safe inside the MongoDB URI.
MONGO_INITDB_ROOT_USERNAME=flux_dev
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_random_local_password
MONGO_DATABASE=flux_studio
MONGODB_HOST_PORT=27017

MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGOOSE_AUTO_INDEX=true
FRONTEND_ORIGIN=http://localhost:5173
