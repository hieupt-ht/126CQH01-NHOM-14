NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/flux_studio
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGOOSE_AUTO_INDEX=true
FRONTEND_ORIGIN=http://localhost:5173

# Phase 2 session configuration. No session secret is needed for opaque DB-backed tokens.
SESSION_COOKIE_NAME=flux_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Gemini provider configuration; leave unset until model access and billing are confirmed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Cloudinary storage credentials. Keep real values in the ignored .env file only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_TIMEOUT_MS=30000
MAX_IMAGE_UPLOAD_MB=10
