NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/flux_studio?authSource=admin&replicaSet=rs0
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGOOSE_AUTO_INDEX=true
FRONTEND_ORIGIN=http://localhost:5173

# JWT authentication cookie. Generate a private 32+ byte key for each environment.
JWT_SECRET=

# Session revocation and browser cookie policy.
SESSION_COOKIE_NAME=flux_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Set true only when MongoDB replica set and both external providers are ready.
GENERATION_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudinary authenticated image storage credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ACCOUNT_ALIAS=demo-primary
CLOUDINARY_TIMEOUT_MS=30000
MAX_IMAGE_UPLOAD_MB=10
IMAGE_STORAGE_NAMESPACE=flux-studio/local
IMAGE_STORAGE_DIR=data/images
DAILY_USER_LIMIT=5
DAILY_APP_LIMIT=20
