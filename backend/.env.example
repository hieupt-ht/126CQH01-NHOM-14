NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/flux_studio
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGOOSE_AUTO_INDEX=true
FRONTEND_ORIGIN=http://localhost:5173

# Phase 2 session configuration. No session secret is needed for opaque DB-backed tokens.
SESSION_COOKIE_NAME=flux_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Phase 3 provider configuration; leave unset until model access and billing are confirmed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Relative paths resolve from the backend working directory.
IMAGE_STORAGE_DIR=data/images
